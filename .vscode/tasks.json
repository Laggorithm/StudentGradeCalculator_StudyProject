{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/cmake.exe",
            "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build", "-G", "MinGW Makefiles", "-DCMAKE_BUILD_TYPE=Debug", "-DCMAKE_C_COMPILER=C:/msys64/ucrt64/bin/gcc.exe"],
            "options": {"env": {"PATH": "C:/msys64/ucrt64/bin;${env:PATH}"}},
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/cmake.exe",
            "args": ["--build", "${workspaceFolder}/build"],
            "dependsOn": "CMake: configure",
            "options": {"env": {"PATH": "C:/msys64/ucrt64/bin;${env:PATH}"}},
            "problemMatcher": ["$gcc"],
            "group": {"kind": "build", "isDefault": true}
        },
        {
            "label": "Run program",
            "type": "process",
            "command": "${workspaceFolder}/build/StudentGradeCalculator.exe",
            "dependsOn": "CMake: build",
            "options": {"cwd": "${workspaceFolder}", "env": {"PATH": "C:/msys64/ucrt64/bin;${env:PATH}"}},
            "problemMatcher": [],
            "presentation": {"reveal": "always", "focus": true, "panel": "dedicated"}
        },
        {
            "label": "Test stage 1",
            "type": "process",
            "command": "${workspaceFolder}/build/Stage1Tester.exe",
            "dependsOn": "CMake: build",
            "options": {"cwd": "${workspaceFolder}", "env": {"PATH": "C:/msys64/ucrt64/bin;${env:PATH}"}},
            "problemMatcher": [],
            "presentation": {"reveal": "always", "panel": "dedicated"}
        }
    ]
}
